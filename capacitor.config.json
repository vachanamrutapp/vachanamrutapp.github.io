{
  "appId": "com.vachanamrut.app",
  "appName": "Vachanamrut",
  "webDir": "www",
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true,
      "backgroundColor": "#E6A623",
      "androidSplashResourceName": "splash",
      "androidScaleType": "CENTER_CROP",
      "splashFullScreen": true,
      "splashImmersive": true,
      "showSpinner": false
    },
    "SystemBars": {
      "style": "LIGHT"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_reminder",
      "iconColor": "#A5252C"
    }
  },
  "backgroundColor": "#E6A623"
}
